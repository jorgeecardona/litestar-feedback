#!/bin/sh
# Release driver, invoked by the `release` moon task (deps `ci`) which the CI job runs
# on the default branch. Idempotent:
#   - if RELEASE_ENABLED is not "1" -> no-op. The first release waits until Jorge has
#     added the PyPI trusted publisher and set the CI/CD variable RELEASE_ENABLED=1.
#   - if the package version is already on PyPI -> no-op (safe on every main pipeline)
#   - else publish it to PyPI via OIDC (scripts/pypi-publish) -- this IS the release
# Publishing needs no token (OIDC Trusted Publishing); there is no git tag step.
set -e
cd "$(CDPATH= cd "$(dirname "$0")/.." && pwd)"

if [ "${RELEASE_ENABLED:-}" != "1" ]; then
    echo "release: held -- set the CI/CD variable RELEASE_ENABLED=1 to publish to PyPI"
    exit 0
fi

V="$(grep -E '^__version__ = "' src/litestar_feedback/__init__.py | head -1 | cut -d'"' -f2)"
[ -n "$V" ] || { echo "release: could not read __version__ from src/litestar_feedback/__init__.py" >&2; exit 1; }

if uv run python - "$V" <<'PY'
import json, sys, urllib.request, urllib.error
version = sys.argv[1]
try:
    data = json.load(urllib.request.urlopen("https://pypi.org/pypi/litestar-feedback/json"))
    sys.exit(0 if version in data["releases"] else 1)
except Exception:
    sys.exit(1)
PY
then
    echo "release: litestar-feedback $V already on PyPI -- nothing to do"
    exit 0
fi

echo "release: publishing litestar-feedback $V to PyPI"
sh scripts/pypi-publish
